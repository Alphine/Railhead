{
  "$schema": "https://railway.com/railway.schema.json",
  "services": {
    "web": {
      "rootDirectory": "apps/web",
      "build": { "builder": "NIXPACKS" },
      "deploy": { "startCommand": "npm run start", "healthcheckPath": "/api/health" },
      "variables": {
        "DATABASE_URL": "${{Postgres.DATABASE_URL}}",
        "REDIS_URL": "${{Redis.REDIS_URL}}",
        "BETTER_AUTH_SECRET": "${{shared.BETTER_AUTH_SECRET}}",
        "BETTER_AUTH_URL": "${{RAILWAY_PUBLIC_DOMAIN}}",
        "NEXT_PUBLIC_APP_URL": "${{RAILWAY_PUBLIC_DOMAIN}}",
        "STRIPE_SECRET_KEY": "${{shared.STRIPE_SECRET_KEY}}",
        "STRIPE_WEBHOOK_SECRET": "${{shared.STRIPE_WEBHOOK_SECRET}}",
        "STRIPE_PRICE_ID_MONTHLY": "${{shared.STRIPE_PRICE_ID_MONTHLY}}",
        "STRIPE_PRICE_ID_ANNUAL": "${{shared.STRIPE_PRICE_ID_ANNUAL}}"
      }
    },
    "worker": {
      "rootDirectory": "apps/worker",
      "build": { "builder": "NIXPACKS" },
      "deploy": { "startCommand": "npm run start" },
      "variables": {
        "DATABASE_URL": "${{Postgres.DATABASE_URL}}",
        "REDIS_URL": "${{Redis.REDIS_URL}}",
        "RESEND_API_KEY": "${{shared.RESEND_API_KEY}}",
        "RESEND_FROM_EMAIL": "${{shared.RESEND_FROM_EMAIL}}",
        "NEXT_PUBLIC_APP_URL": "${{RAILWAY_PUBLIC_DOMAIN}}"
      }
    }
  }
}
